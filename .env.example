# RealMoney - environment template. This file IS committed.
# Names only, never values. Copy to .env.local and fill it in there,
# or let `npx neon@latest init` write them for you.

# Neon POOLED endpoint (host contains "-pooler"). Used by the app at runtime.
# The neon-serverless driver talks over a WebSocket, which is what allows
# transactions; neon-http cannot hold a session open, and the OCR batch-create
# needs one.
DATABASE_URL=

# Neon DIRECT endpoint (host WITHOUT "-pooler"). Used by drizzle-kit only.
# Migrations take advisory locks and issue DDL, both tied to a session. Through
# a transaction pooler each statement can land on a different backend, so the
# lock protects nothing.
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth). Written by `neon config apply`, not by hand.
# NOTE: the spec described Stack Auth with an async neon_auth.users_sync mirror.
# That is not what this is: Managed Better Auth creates real tables in this same
# database, and user ids are uuid, not text.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Which Neon branch the CLI is pointed at.
NEON_BRANCH=

# Google OAuth - optional. Magic link works without it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
