# RealMoney - environment template. This file IS committed.
# Names only, never values. Copy to .env.local and fill it in there,
# or let `npx neon@latest init` write them for you.

# Neon POOLED endpoint (host contains "-pooler"). Used by the app at runtime.
# The neon-serverless driver talks over a WebSocket, which is what allows
# transactions; neon-http cannot hold a session open, and the OCR batch-create
# needs one.
DATABASE_URL=

# Neon DIRECT endpoint (host WITHOUT "-pooler"). Used by drizzle-kit only.
# Migrations take advisory locks and issue DDL, both tied to a session. Through
# a transaction pooler each statement can land on a different backend, so the
# lock protects nothing.
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth). Written by `neon config apply`, not by hand.
# NOTE: the spec described Stack Auth with an async neon_auth.users_sync mirror.
# That is not what this is: Managed Better Auth creates real tables in this same
# database, and user ids are uuid, not text.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Signs the session_data cookie the auth proxy mints on OUR domain. NOT written
# by the Neon CLI - this one is ours, and it must differ between local and
# production. At least 32 characters:
#   openssl rand -base64 32
# Anyone holding it can forge a session for any user id. Treat it like a
# password, and if it ever reaches a commit, rotate it - deleting is not enough.
NEON_AUTH_COOKIE_SECRET=

# Which Neon branch the CLI is pointed at.
NEON_BRANCH=

# Signs the bearer tokens that /api/v1/quick-add accepts. The iOS Shortcut
# cannot hold a session cookie, so it authenticates with a token that carries a
# user id and an HMAC of it; verifying means recomputing the HMAC, so no token
# is ever stored. At least 32 characters:
#   openssl rand -base64 32
# Anyone holding it can write transactions to ANY account. Rotating it is the
# only revocation there is - it invalidates every issued token at once.
INGEST_TOKEN_SECRET=

# Google OAuth - optional. The email one-time code works without it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
